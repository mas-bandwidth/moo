; The moo roadmap: the data ROADMAP.md is generated from, in the shape of
; mas-bandwidth/schema's docs/roadmap.sexp (one restricted S-expression; data, never evaluated).
; ROADMAP.md is rendered by tools/roadmap/render.lisp (vendored from mas-bandwidth/schema
; tools/roadmap at 609d4e032aff3323e4ee3a3495a1c86d56720914): edit this file, then `make roadmap`; `make roadmap-check`
; fails when the committed page is not what this data renders. Never edit ROADMAP.md by hand.
;
; A cell is ✅ only when every task under it is :done, and a :done task names its evidence (the
; land commit of the sprint card that built it, on the branch named). Every ❌ task names its
; sprint card, the archive file that keeps the card's whole brief and record, and its last pushed
; head. Rewritten 2026-10-20 at the pit stop, when Glenn archived every sprint stream that is not
; rocketnet: "Archive everything from the sprint that isn't rocketnet. Move the cards into their
; respective roadmaps."
(:schema 1 :root "moo/roadmap"
 :page (:title "moo roadmap"
        :roadmaps ("layer-3" "layer-4" "layer-5" "layer-3b" "nightly")
        :closing ((:title "About this page" :text ("Each table lists the features of one area: ✅ is built, tested and landed, with the evidence in the source data; ❌ is not yet. The open rows were sprint cards when the sprint stopped for its pit stop on 2026-10-20; each one names its card, its archived brief and any pushed head in the source data, so the work can be picked up again."))))
 :nodes
 ((:id "moo/roadmap" :type :work-set :children ("layer-3" "layer-4" "layer-5" "layer-3b" "nightly"))
  (:id "layer-3" :type :roadmap :title "Fixed-point numbers through the toolchain"
   :text ("Layer 3: every number in moo is Q48.16 fixed point, from the parser and compiler to the bytecode and the VM; the integer and vector types of Luau are removed. Built on the integration branch sprint/moo and merged into main on 2026-10-21.")
   :rows
   (("test-layout" "Each layer 3 change has its own test files")
    ("readme" "README says what is built")
    ("libs-out" "No vector or integer library is opened")
    ("vector-out" "Vector type removed from the C API, compiler and VM")
    ("analyzer" "Analyzer builtins drop os, vector and integer")
    ("raw-constants" "Parser and compiler carry exact raw Q48.16 constants")
    ("bytecode" "Bytecode version and constant folding in fixed point")
    ("integer-args" "Integer arguments refuse a fraction by name, fastcalls included")
    ("float-boundary" "The float boundary: tofloat, buffer floats and string.pack floats")
    ("overflow" "Named overflow errors in checked builds")
    ("oracle" "Layer 3 conformance oracle, harness and bridge gate")
    ("patch-inventory" "Upstream merge checklist and its push gate")
    ("base-reds" "Known base failures named; clean compiler warnings"))
   :columns (("moo" "moo"))
   :cells
   (("test-layout" "moo" "layer-3/test-layout")
    ("readme" "moo" "layer-3/readme")
